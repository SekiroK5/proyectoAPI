# =====================================================================
# Plantilla: copie este archivo como .env y ajuste los valores.
# Spring Boot lo lee al arrancar (spring.config.import en application.properties).
# =====================================================================

# --- Base de datos PostgreSQL local ---
DB_URL=jdbc:postgresql://localhost:5432/practica1_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Inicio de sesion (JWT) ---
# Secreto HS256 de al menos 32 caracteres, solo para desarrollo local
JWT_SECRETO=cambie-este-valor-por-un-secreto-de-al-menos-32-caracteres

# --- GestoPago / PuntoRed: credenciales de PRUEBA publicadas en su documentacion ---
GESTOPAGO_ID_DISTRIBUIDOR=83
GESTOPAGO_CODIGO_DISPOSITIVO=GPS83-TPV-17
GESTOPAGO_PASSWORD=12345678
# Llave e IV AES-256-CBC (Base64) del "Test key pair" de la documentacion
GESTOPAGO_SECRET_KEY=HPo7OLqB4Fkk4E2yGOtwqw8H5fHR9kNx67OR4g4UdlA=
GESTOPAGO_IV=p5ldmBPdd/9pjC0bDC/nSg==
# Opcional: solo si PuntoRed asigno una X-API-Key
GESTOPAGO_API_KEY=
GESTOPAGO_UNIDAD=083

# --- Cuentas ---
# Saldo de prueba con el que abre cada cuenta nueva
SALDO_INICIAL_CUENTA=1000.00
DEPOSITO_MONTO_MAXIMO=50000.00

# --- Servidor ---
PORT=8081
